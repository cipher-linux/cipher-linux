Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

/*
 * CIPHER Linux Plymouth Theme
 *
 * Static logo (dots baked into artwork).
 * Fade in from a visible floor opacity to full brightness,
 * then hold until boot finishes.
 */

/* ---------------------------------------------------------
 * Logo sprite
 * --------------------------------------------------------- */

logo_image_raw = Image("frames/00.png");

/*
 * Scale to a fixed proportion of window height, not the source
 * file's raw pixel size — keeps the full mark + wordmark + tagline
 * on screen regardless of source resolution or display resolution.
 * Source art is a square canvas (logo + text + tagline stacked
 * inside one image), so scale by height and let width follow.
 */

logo_target_height = Window.GetHeight() * 0.55;
logo_scale_ratio = logo_target_height / logo_image_raw.GetHeight();
logo_target_width = logo_image_raw.GetWidth() * logo_scale_ratio;

logo_image = logo_image_raw.Scale(logo_target_width, logo_target_height);
logo_sprite = Sprite(logo_image);

logo_x = Window.GetWidth() / 2 - logo_image.GetWidth() / 2;
logo_y = Window.GetHeight() / 2 - logo_image.GetHeight() / 2;

logo_sprite.SetX(logo_x);
logo_sprite.SetY(logo_y);

/* ---------------------------------------------------------
 * Fade-in state
 *
 * NOTE: like the rest of this theme, timing is governed by
 * refresh-call counts, not wall-clock time (Plymouth's script
 * refresh rate isn't guaranteed, but this matches the existing
 * project convention and is close enough in practice).
 * --------------------------------------------------------- */

fade_floor = 0.45;      /* never start from near-invisible */
fade_target = 1.0;      /* full brightness, not dimmed */
fade_step = 0.03;       /* per-refresh opacity increase */

logo_opacity = fade_floor;
logo_sprite.SetOpacity(logo_opacity);

/* ---------------------------------------------------------
 * Progress bar
 * --------------------------------------------------------- */

bar_width = 400;
bar_height = 6;

bar_x = Window.GetWidth() / 2 - bar_width / 2;
bar_y = Window.GetHeight() - 100;

bar_track_image = Image.Text(
    "",
    0.10,
    0.10,
    0.12
).Scale(
    bar_width,
    bar_height
);

bar_track_sprite = Sprite(bar_track_image);

bar_track_sprite.SetX(bar_x);
bar_track_sprite.SetY(bar_y);

bar_fill_sprite = Sprite();

bar_fill_sprite.SetX(bar_x);
bar_fill_sprite.SetY(bar_y);

/* ---------------------------------------------------------
 * Refresh callback
 * --------------------------------------------------------- */

fun refresh_callback() {

    if (logo_opacity < fade_target) {

        logo_opacity += fade_step;

        if (logo_opacity >= fade_target) {
            logo_opacity = fade_target;
        }

        logo_sprite.SetOpacity(logo_opacity);
    }
}

/* ---------------------------------------------------------
 * Boot progress callback
 * --------------------------------------------------------- */

fun boot_progress_callback(duration, progress) {

    fill_width = bar_width * progress;

    if (fill_width < 1) {
        fill_width = 1;
    }

    fill_image = Image.Text(
        "",
        0.10,
        0.75,
        1
    ).Scale(
        fill_width,
        bar_height
    );

    bar_fill_sprite.SetImage(fill_image);
}

/* ---------------------------------------------------------
 * Plymouth callbacks
 * --------------------------------------------------------- */

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(boot_progress_callback);
