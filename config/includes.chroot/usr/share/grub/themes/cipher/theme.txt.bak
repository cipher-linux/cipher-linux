title-text: ""
desktop-image: "splash.png"
desktop-color: "#000000"
terminal-font: "Rajdhani Regular 16"

+ vbox {
  top = 15%
  left = 8%
  width = 30%
  height = 10%

  + label {
    text = "CIPHER"
    font = "Rajdhani Regular 32"
    color = "#FFFFFF"
    align = "left"
  }
  + label {
    text = "LINUX"
    font = "Rajdhani Regular 24"
    color = "#00BCD4"
    align = "left"
  }
  + label {
    text = "SECURE. PRIVATE. YOURS."
    font = "Rajdhani Regular 12"
    color = "#888888"
    align = "left"
  }
}

+ boot_menu {
  left = 8%
  top = 35%
  width = 45%
  height = 40%
  item_height = 45
  item_spacing = 8
  item_font = "Rajdhani Regular 16"
  item_color = "#AAAAAA"
  selected_item_font = "Rajdhani Regular 16"
  selected_item_color = "#FFFFFF"
  selected_item_pixmap_style = ""
  item_height = 45
  selected_item_color = "#000000"
  selected_item_bg_color = "#00BCD4"
}

+ hbox {
  top = 92%
  left = 8%
  width = 84%
  height = 6%

  + label { text = "Enter: Boot   e: Edit   c: Command Line   Esc: Back" font = "Rajdhani Regular 12" color = "#666666" align = "left" }
}
