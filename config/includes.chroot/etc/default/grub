GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="CIPHER Linux"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3"
GRUB_CMDLINE_LINUX=""

# Force video output mode for graphical themes
GRUB_TERMINAL_OUTPUT="gfxterm"
GRUB_GFXMODE="auto"

# Theme location
GRUB_THEME="/boot/grub/themes/cipher/theme.txt"
GRUB_BACKGROUND="/boot/grub/themes/cipher/background.png"
GRUB_GFXPAYLOAD_LINUX="keep"
